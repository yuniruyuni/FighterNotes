{
  "name": "@fighter-notes/server",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "watch:run": "STATIC_DIR=../client/static PUBLIC_BASE_URL=http://localhost:3000 bun run --watch src/index.ts",
    "build": "NODE_ENV=production bun build src/index.ts --compile --outfile dist/server",
    "check:lint": "biome check .",
    "check:functions": "bun --config=bunfig.models.toml test --coverage src/models",
    "check:test": "bun test src/",
    "check:type": "tsc --noEmit",
    "fix:lint": "biome check --write .",
    "watch:test": "bun test --watch src/",
    "watch:type": "tsc --noEmit --watch"
  },
  "dependencies": {
    "@hono/trpc-server": "^0.4.2",
    "@trpc/server": "^11.10.0",
    "hono": "^4.12.23",
    "pg": "^8.20.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.11",
    "@types/pg": "^8.20.0",
    "typescript": "^6.0.0"
  }
}
