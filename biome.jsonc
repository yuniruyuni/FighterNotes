{
  "$schema": "https://biomejs.dev/schemas/2.4.9/schema.json",
  "vcs": { "clientKind": "git", "enabled": true, "useIgnoreFile": true },
  "files": {
    "ignoreUnknown": true,
    "includes": ["**", "!**/dev/**", "!**/static/**"]
  },
  "css": {
    "parser": { "tailwindDirectives": true }
  },
  "formatter": {
    "enabled": true,
    "formatWithErrors": false,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "linter": {
    "enabled": true,
    "rules": { "recommended": true }
  },
  "overrides": [
    {
      // fighter の SPA（client）: mp4box/WebCodecs は型なしで any 必須、
      // DOM 取得後の非 null は運用保証、対戦動画に字幕はない
      "includes": ["client/**"],
      "linter": {
        "rules": {
          "suspicious": { "noExplicitAny": "off" },
          "style": { "noNonNullAssertion": "off" },
          "a11y": { "useMediaCaption": "off" }
        }
      }
    }
  ]
}
