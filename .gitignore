# OS metadata
.DS_Store

# Local environment files and secrets
.env
.env.*
!.env.example
!.env.*.example

# Local tool state
/.claude/
/.playwright-mcp/
/TaskList.md

# Installed dependencies
node_modules/

# Build output
/target/
# 適合テストの crate は本体のワークスペースから外してあり、生成物も別に出る。
crates/shader-conformance/target/
/crates/wasm-bridge/pkg/
/client/static/
/server/dist/

